{
  "name": "web",
  "version": "2.3.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --define \"MAPBOX_ACCESS_TOKEN='${NG_APP_MAPBOX_ACCESS_TOKEN:-}'\" && node hosting/generate-hosting-files.ts",
    "test": "ng test --watch=false && pnpm run test:worker && pnpm run test:hosting",
    "test:watch": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.hosting.json",
    "start:dev": "ng serve",
    "test:worker": "vitest run --config vitest.worker.config.ts worker",
    "test:hosting": "vitest run --config vitest.worker.config.ts hosting",
    "start:container": "ng serve --host 0.0.0.0",
    "deploy:worker": "wrangler deploy",
    "preview:worker": "wrangler dev"
  },
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/service-worker": "22.3.0",
    "@genialtanken/contracts": "workspace:*",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.6",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  },
  "type": "module"
}
