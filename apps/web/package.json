{
  "name": "web",
  "version": "2.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --define \"MAPBOX_ACCESS_TOKEN='${NG_APP_MAPBOX_ACCESS_TOKEN:-}'\"",
    "test": "ng test --watch=false && pnpm run test:functions",
    "test:watch": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.functions.json",
    "start:dev": "ng serve",
    "test:functions": "vitest run --config vitest.functions.config.ts",
    "start:container": "ng serve --host 0.0.0.0",
    "deploy": "wrangler pages deploy dist/web/browser --project-name=genialtanken --branch=main",
    "preview": "wrangler pages dev dist/web/browser"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@genialtanken/contracts": "workspace:*",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.1",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "24.19.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.144.0"
  },
  "type": "module"
}
