{
  "name": "web",
  "version": "2.1.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --define \"MAPBOX_ACCESS_TOKEN='${NG_APP_MAPBOX_ACCESS_TOKEN:-}'\"",
    "test": "ng test --watch=false && pnpm run test:worker",
    "test:watch": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.worker.json",
    "start:dev": "ng serve",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "start:container": "ng serve --host 0.0.0.0",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@genialtanken/contracts": "workspace:*",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "type": "module"
}
