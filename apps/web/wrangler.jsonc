// Cloudflare Worker that serves the built Angular app and proxies `/api/*` to the API.
// Deliberately no `build` section: deploys must never run commands from this file. Build the
// app first (`pnpm --filter web build`), then run `wrangler deploy`.
// API_ORIGIN and PROXY_SHARED_SECRET are not set here. They are variables or secrets of the
// Worker in Cloudflare, and locally they come from `apps/web/.dev.vars` (never committed).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genialtanken",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  // Keeps the free Render API awake from 06:00 to midnight in Berlin (worker/keep-awake/).
  "triggers": { "crons": ["*/5 * * * *"] },
  "preview_urls": true,
  "workers_dev": true,
  // API_ORIGIN is a dashboard variable; without this a manual `wrangler deploy` would delete it.
  "keep_vars": true,
}
