// Cloudflare Worker that redirects the old `workers.dev` address to the web app on static hosting
// and keeps the free Render API awake (docs/adr/0001-leave-cloudflare-proxy.md). It serves no
// assets and proxies nothing.
// Deliberately no `build` section: deploys must never run commands from this file.
// API_ORIGIN is not set here. It is a variable of the Worker in Cloudflare, and locally it comes
// from `apps/web/.dev.vars` (never committed).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genialtanken",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-03",
  // Keeps the free Render API awake from 06:00 to midnight in Berlin (worker/keep-awake/).
  "triggers": { "crons": ["*/5 * * * *"] },
  "workers_dev": true,
  "preview_urls": false,
  // API_ORIGIN is a dashboard variable; without this a manual `wrangler deploy` would delete it.
  "keep_vars": true,
}
