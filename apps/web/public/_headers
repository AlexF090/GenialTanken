# Response headers of the static assets (Cloudflare Workers). Copied unchanged into
# dist/web/browser by the Angular build. They do not apply to the Worker's /api responses.
# Headers of all matching rules are combined; `! Name` removes a header set by a broader rule.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Angular emits scripts and styles with a content hash (outputHashing: all), and
# fonts and images referenced from styles land hashed in /media/.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Icons keep stable names, so they may only be cached briefly.
/icons/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400

# The service worker and its manifest decide which app version runs, so the browser must
# revalidate them on every request; `/*.js` would otherwise make the workers immutable for a
# year. index.html (also served for `/`) is what the service worker compares against the
# manifest. Every rule removes inherited Cache-Control first, so a broader rule added later
# cannot sneak in a long cache time.
/ngsw-worker.js
  ! Cache-Control
  Cache-Control: no-cache
/safety-worker.js
  ! Cache-Control
  Cache-Control: no-cache
# Legacy name of the safety worker, emitted by the build as well.
/worker-basic.min.js
  ! Cache-Control
  Cache-Control: no-cache
/ngsw.json
  ! Cache-Control
  Cache-Control: no-cache
/index.html
  ! Cache-Control
  Cache-Control: no-cache
/
  ! Cache-Control
  Cache-Control: no-cache
