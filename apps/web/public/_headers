# Cloudflare Pages response headers. Copied unchanged into dist/web/browser by the Angular build.
# Headers of all matching rules are combined.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

# Angular emits scripts and styles with a content hash (outputHashing: all), and
# fonts and images referenced from styles land hashed in /media/.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Icons keep stable names, so they may only be cached briefly.
/icons/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
