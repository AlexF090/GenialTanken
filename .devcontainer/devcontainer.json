{
  "name": "GenialTanken",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.1-26-trixie@sha256:a10d33dab2cceee38cae5c732dfd155a76d5cf915a3b22a269826697d52d0a44",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "initializeCommand": "bash .devcontainer/check-claude-config.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/node/.claude.json.seed,type=bind,readonly",
    "source=${localEnv:HOME}/Developer/dotfiles,target=${localEnv:HOME}/Developer/dotfiles,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.agents,target=${localEnv:HOME}/.agents,type=bind,readonly",
    "source=genialtanken-claude-plugins,target=/home/node/.claude/plugins,type=volume",
    "source=genialtanken-gh-config,target=/home/node/.config/gh,type=volume",
    "source=${localEnv:HOME}/.zsh_history,target=/home/node/.zsh_history,type=bind,consistency=cached"
  ],
  "forwardPorts": [9323],
  "portsAttributes": {
    "4200": {
      "label": "Web (Angular dev server)"
    },
    "3000": {
      "label": "API (NestJS)"
    },
    "9323": {
      "label": "Playwright report"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "angular.ng-template",
        "vitest.explorer",
        "ms-playwright.playwright"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  },
  "appPort": ["4200:4200", "3000:3000"]
}
