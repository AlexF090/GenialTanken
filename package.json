{
  "name": "genialtanken",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gas station price app: list and map of daily fuel prices by location and radius.",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --parallel --filter web --filter api run start:dev",
    "dev:container": "pnpm --parallel --filter web --filter api run start:container",
    "build": "pnpm --recursive --filter \"./apps/*\" --filter \"./packages/*\" run build",
    "test": "pnpm --recursive --filter \"./apps/*\" --filter \"./packages/*\" run test",
    "test:e2e": "pnpm --filter e2e test",
    "deploy:web": "pnpm --filter web build && pnpm --filter web run deploy",
    "preview:web": "pnpm --filter web build && pnpm --filter web run preview",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive run typecheck",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "angular-eslint": "22.5.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
