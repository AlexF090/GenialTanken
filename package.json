{
  "name": "genialtanken",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gas station price app: list and map of daily fuel prices by location and radius.",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "client": "pnpm --filter client start",
    "server": "pnpm --filter server start",
    "build": "pnpm --filter client build",
    "test": "pnpm --filter client test",
    "storybook": "pnpm --filter client storybook",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write ."
  },
  "license": "ISC"
}
