{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "typeRoots": ["../e2e/node_modules/@types"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@playwright/test": ["../e2e/node_modules/@playwright/test/index.d.ts"]
    }
  },
  "include": ["*.ts"]
}
